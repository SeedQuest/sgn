<%init>
  my $tag;
  my $commit;
  my $updated;

  # In most production images .git is not present.
  # Prefer environment variables for stable build info.
    $tag     = $ENV{VERSION}     || "v1.83";
    $updated = $ENV{BUILD_DATE}  || "";

  # Optional: if git exists (dev images), show commit/tag/date.
  system("git -C . rev-parse 2>/dev/null");
  my $isGit = `echo $?`;
  if ($isGit == 0) {
    $tag     = `git describe --abbrev=0 --tags 2>/dev/null` || $tag;
    chomp($tag);
    $commit  = `git rev-parse --short HEAD 2>/dev/null`;
    chomp($commit);
    $updated = `git log -1 --format=%cd 2>/dev/null` || $updated;
    chomp($updated);
  }
</%init>

<!-- BEGIN SITE FOOTER (SeedQuest). -->

