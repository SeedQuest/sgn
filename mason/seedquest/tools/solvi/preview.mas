<%args>
</%args>

<style>
.sq-solvi-wrap {
  max-width: 1180px;
  margin: 28px auto;
  padding: 0 18px 42px;
}
.sq-solvi-title {
  margin-bottom: 18px;
  text-align: center;
}
.sq-solvi-title h1 {
  margin: 0 0 8px;
  font-size: 32px;
  font-weight: 800;
  color: #0f172a;
}
.sq-solvi-title .sq-solvi-line {
  width: 80px;
  height: 4px;
  margin: 0 auto;
  border-radius: 2px;
  background: #06b6d4;
}
.sq-solvi-panel {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
  margin-bottom: 18px;
}
.sq-solvi-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  padding: 16px 18px;
  border-bottom: 1px solid #e5e7eb;
}
.sq-solvi-panel-head .sq-solvi-muted {
  max-width: 100%;
  overflow-wrap: anywhere;
}
.sq-solvi-panel-head h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 700;
  color: #0f172a;
}
.sq-solvi-body {
  padding: 18px;
}
.sq-solvi-form {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) auto;
  gap: 12px;
  align-items: center;
}
.sq-solvi-meta {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(160px, 1fr));
  gap: 12px;
  margin-top: 4px;
}
.sq-solvi-meta label {
  display: block;
}
.sq-solvi-meta span {
  display: block;
  margin-bottom: 5px;
  color: #475569;
  font-size: 13px;
  font-weight: 700;
}
.sq-solvi-meta input {
  width: 100%;
  min-height: 40px;
  padding: 8px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
}
.sq-solvi-meta-wide {
  grid-column: span 2;
}
.sq-solvi-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: flex-end;
}
.sq-solvi-file {
  display: block;
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background: #fff;
}
.sq-solvi-btn {
  min-height: 44px;
  padding: 0 22px;
  border: 0;
  border-radius: 6px;
  background: #2563eb;
  color: #fff;
  font-weight: 700;
}
.sq-solvi-btn--verify {
  background: #0f766e;
}
.sq-solvi-btn:disabled {
  opacity: .65;
}
.sq-solvi-error {
  display: none;
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 6px;
  background: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
}
.sq-solvi-verify {
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 6px;
  background: #ecfdf5;
  color: #065f46;
  border: 1px solid #a7f3d0;
}
.sq-solvi-verify--warning {
  background: #fffbeb;
  color: #92400e;
  border-color: #fde68a;
}
.sq-solvi-kpis {
  display: grid;
  grid-template-columns: repeat(5, minmax(120px, 1fr));
  gap: 12px;
}
.sq-solvi-kpi {
  padding: 14px;
  border-radius: 8px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}
.sq-solvi-kpi b {
  display: block;
  font-size: 24px;
  color: #0f172a;
}
.sq-solvi-kpi span {
  display: block;
  margin-top: 4px;
  color: #64748b;
  font-size: 13px;
}
.sq-solvi-status {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 0 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}
.sq-solvi-status--matched {
  background: #dcfce7;
  color: #166534;
}
.sq-solvi-status--missing {
  background: #fef3c7;
  color: #92400e;
}
.sq-solvi-table-wrap {
  overflow-x: auto;
}
.sq-solvi-table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
}
.sq-solvi-table th,
.sq-solvi-table td {
  padding: 10px 12px;
  border-bottom: 1px solid #e5e7eb;
  vertical-align: top;
}
.sq-solvi-table th {
  color: #475569;
  font-weight: 700;
  background: #f8fafc;
}
.sq-solvi-muted {
  color: #64748b;
}
.sq-solvi-checksum {
  display: block;
  margin-top: 8px;
  font-family: Consolas, "Liberation Mono", monospace;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.sq-solvi-hidden {
  display: none;
}
@media (max-width: 720px) {
  .sq-solvi-form,
  .sq-solvi-kpis,
  .sq-solvi-meta {
    grid-template-columns: 1fr;
  }
  .sq-solvi-meta-wide {
    grid-column: auto;
  }
  .sq-solvi-actions {
    justify-content: stretch;
  }
  .sq-solvi-actions .sq-solvi-btn {
    flex: 1 1 0;
  }
  .sq-solvi-title h1 {
    font-size: 26px;
  }
  .sq-solvi-table {
    min-width: 0;
  }
  .sq-solvi-table th,
  .sq-solvi-table td {
    padding: 8px 10px;
    overflow-wrap: anywhere;
  }
}
</style>

<div class="sq-solvi-wrap">
  <div class="sq-solvi-title">
    <h1>Solvi CSV Preview</h1>
    <div class="sq-solvi-line"></div>
  </div>

  <div class="sq-solvi-panel">
    <div class="sq-solvi-panel-head">
      <h2>Upload Zonal Statistics CSV</h2>
      <span class="sq-solvi-status sq-solvi-status--missing">Dry run</span>
    </div>
    <div class="sq-solvi-body">
      <form id="sq-solvi-form" class="sq-solvi-form">
        <input id="sq-solvi-file" name="solvi_csv_file" class="sq-solvi-file" type="file" accept=".csv,text/csv">
        <div class="sq-solvi-actions">
          <button id="sq-solvi-submit" class="sq-solvi-btn" type="submit">Preview</button>
          <button id="sq-solvi-verify" class="sq-solvi-btn sq-solvi-btn--verify" type="button">Verify Write</button>
        </div>
        <div class="sq-solvi-meta">
          <label>
            <span>Flight timestamp</span>
            <input id="sq-solvi-flight-timestamp" name="flight_timestamp" type="datetime-local">
          </label>
          <label>
            <span>Sensor</span>
            <input id="sq-solvi-sensor" name="sensor" type="text" placeholder="Solvi">
          </label>
          <label>
            <span>Platform</span>
            <input id="sq-solvi-platform" name="platform" type="text" placeholder="UAV">
          </label>
          <label>
            <span>Processing</span>
            <input id="sq-solvi-processing-version" name="processing_version" type="text" placeholder="Solvi export">
          </label>
          <label class="sq-solvi-meta-wide">
            <span>Source ID</span>
            <input id="sq-solvi-source-id" name="source_id" type="text" placeholder="Mission, flight, or archive reference">
          </label>
        </div>
      </form>
      <div id="sq-solvi-error" class="sq-solvi-error"></div>
      <div id="sq-solvi-verify-result" class="sq-solvi-verify sq-solvi-hidden"></div>
    </div>
  </div>

  <div id="sq-solvi-result" class="sq-solvi-hidden">
    <div class="sq-solvi-panel">
      <div class="sq-solvi-panel-head">
        <h2>Summary</h2>
        <span id="sq-solvi-file-name" class="sq-solvi-muted"></span>
      </div>
      <div class="sq-solvi-body">
        <div class="sq-solvi-kpis">
          <div class="sq-solvi-kpi"><b id="sq-solvi-units">0</b><span>Plot units</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-vars">0</b><span>Variables</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-obs">0</b><span>Observations</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-buffers">0</b><span>Buffers dropped</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-date">-</b><span>Flight date</span></div>
        </div>
        <span id="sq-solvi-checksum" class="sq-solvi-muted sq-solvi-checksum"></span>
      </div>
    </div>

    <div id="sq-solvi-duplicate-panel" class="sq-solvi-panel sq-solvi-hidden">
      <div class="sq-solvi-panel-head">
        <h2>Duplicate Check</h2>
        <span id="sq-solvi-duplicate-status" class="sq-solvi-status sq-solvi-status--matched">Clean</span>
      </div>
      <div class="sq-solvi-body">
        <div class="sq-solvi-kpis">
          <div class="sq-solvi-kpi"><b id="sq-solvi-dup-checked">0</b><span>Checked observations</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-dup-existing">0</b><span>Existing timestamp hits</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-dup-same">0</b><span>Same values</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-dup-changed">0</b><span>Changed values</span></div>
          <div class="sq-solvi-kpi"><b id="sq-solvi-dup-files">0</b><span>Matching file checksums</span></div>
        </div>
      </div>
      <div id="sq-solvi-duplicate-examples" class="sq-solvi-body sq-solvi-table-wrap sq-solvi-hidden">
        <table class="sq-solvi-table">
          <thead>
            <tr>
              <th>Plot</th>
              <th>Trait</th>
              <th>Incoming</th>
              <th>Existing</th>
              <th>Phenotype ID</th>
            </tr>
          </thead>
          <tbody id="sq-solvi-duplicate-body"></tbody>
        </table>
      </div>
    </div>

    <div class="sq-solvi-panel">
      <div class="sq-solvi-panel-head">
        <h2>Trait Mapping</h2>
      </div>
      <div class="sq-solvi-body sq-solvi-table-wrap">
        <table class="sq-solvi-table">
          <thead>
            <tr>
              <th>Solvi Variable</th>
              <th>Breedbase Match</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="sq-solvi-traits"></tbody>
        </table>
      </div>
    </div>

    <div class="sq-solvi-panel">
      <div class="sq-solvi-panel-head">
        <h2>Plot Preview</h2>
        <span class="sq-solvi-muted">first 10 rows</span>
      </div>
      <div class="sq-solvi-body sq-solvi-table-wrap">
        <table class="sq-solvi-table">
          <thead>
            <tr>
              <th>Zone</th>
              <th>Values</th>
            </tr>
          </thead>
          <tbody id="sq-solvi-units-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  function esc(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showError(message) {
    jQuery('#sq-solvi-error').text(message).show();
    jQuery('#sq-solvi-verify-result').addClass('sq-solvi-hidden');
  }

  function showVerify(message, isWarning) {
    jQuery('#sq-solvi-error').hide();
    jQuery('#sq-solvi-verify-result')
      .toggleClass('sq-solvi-verify--warning', !!isWarning)
      .text(message)
      .removeClass('sq-solvi-hidden');
  }

  function renderDuplicates(report) {
    if (!report) {
      jQuery('#sq-solvi-duplicate-panel').addClass('sq-solvi-hidden');
      return;
    }

    var existing = report.existing_observation_count || 0;
    var changed = report.changed_value_count || 0;
    var fileDuplicates = report.file_duplicate_count || 0;
    var isWarning = existing > 0 || fileDuplicates > 0;
    jQuery('#sq-solvi-duplicate-panel').removeClass('sq-solvi-hidden');
    jQuery('#sq-solvi-duplicate-status')
      .toggleClass('sq-solvi-status--matched', !isWarning)
      .toggleClass('sq-solvi-status--missing', isWarning)
      .text(isWarning ? 'Needs review' : 'Clean');
    jQuery('#sq-solvi-dup-checked').text(report.checked_observation_count || 0);
    jQuery('#sq-solvi-dup-existing').text(existing);
    jQuery('#sq-solvi-dup-same').text(report.same_value_count || 0);
    jQuery('#sq-solvi-dup-changed').text(changed);
    jQuery('#sq-solvi-dup-files').text(fileDuplicates);

    var examples = report.examples || [];
    if (!examples.length) {
      jQuery('#sq-solvi-duplicate-examples').addClass('sq-solvi-hidden');
      jQuery('#sq-solvi-duplicate-body').empty();
      return;
    }
    var rows = examples.map(function(item) {
      return '<tr><td>' + esc(item.unit) + '</td><td>' + esc(item.trait) + '</td><td>' + esc(item.incoming_value) + '</td><td>' + esc(item.existing_value) + '</td><td>' + esc(item.phenotype_id) + '</td></tr>';
    }).join('');
    jQuery('#sq-solvi-duplicate-body').html(rows);
    jQuery('#sq-solvi-duplicate-examples').removeClass('sq-solvi-hidden');
  }

  function displayTimestamp(data) {
    if (data.flight_timestamp_input) {
      return data.flight_timestamp_input.replace('T', ' ');
    }
    if (data.flight_timestamp) {
      return data.flight_timestamp.replace('T', ' ').replace(/[+-]\d{4}$/, '');
    }
    return data.flight_date || '-';
  }

  function render(data) {
    jQuery('#sq-solvi-error').hide();
    jQuery('#sq-solvi-result').removeClass('sq-solvi-hidden');
    jQuery('#sq-solvi-file-name').text(data.filename || '');
    jQuery('#sq-solvi-units').text(data.unit_count || 0);
    jQuery('#sq-solvi-vars').text(data.variable_count || 0);
    jQuery('#sq-solvi-obs').text(data.observation_count || 0);
    jQuery('#sq-solvi-buffers').text(data.dropped_buffers || 0);
    jQuery('#sq-solvi-date').text(displayTimestamp(data));
    jQuery('#sq-solvi-checksum').text(data.file_md5 ? 'MD5: ' + data.file_md5 : '');
    if (data.flight_timestamp_input && !jQuery('#sq-solvi-flight-timestamp').val()) {
      jQuery('#sq-solvi-flight-timestamp').val(data.flight_timestamp_input);
    }
    renderDuplicates(data.duplicates);

    var traits = data.variables || [];
    var traitHtml = traits.map(function(item) {
      var status = item.status === 'matched' ? 'matched' : 'missing';
      var label = status === 'matched' ? 'Matched' : 'Missing';
      var matched = item.matched_name ? item.matched_name + ' (#' + item.cvterm_id + ')' : '-';
      return '<tr><td>' + esc(item.name) + '</td><td>' + esc(matched) + '</td><td><span class="sq-solvi-status sq-solvi-status--' + status + '">' + label + '</span></td></tr>';
    }).join('');
    jQuery('#sq-solvi-traits').html(traitHtml);

    var unitHtml = (data.preview_units || []).map(function(unit) {
      var values = unit.values || {};
      var pairs = Object.keys(values).sort().map(function(key) {
        return '<span><b>' + esc(key) + ':</b> ' + esc(values[key]) + '</span>';
      }).join('<br>');
      return '<tr><td><b>' + esc(unit.unit) + '</b></td><td>' + pairs + '</td></tr>';
    }).join('');
    jQuery('#sq-solvi-units-body').html(unitHtml);
  }

  function uploadSolvi(endpoint, buttonSelector, busyText, doneText, onSuccess) {
    var fileInput = document.getElementById('sq-solvi-file');
    if (!fileInput.files.length) {
      showError('Choose a Solvi CSV file first.');
      return;
    }

    var formData = new FormData();
    formData.append('solvi_csv_file', fileInput.files[0]);
    ['flight_timestamp', 'sensor', 'platform', 'processing_version', 'source_id'].forEach(function(name) {
      var field = document.querySelector('[name="' + name + '"]');
      if (field && field.value) {
        formData.append(name, field.value);
      }
    });

    jQuery(buttonSelector).prop('disabled', true).text(busyText);
    jQuery.ajax({
      url: endpoint,
      method: 'POST',
      data: formData,
      processData: false,
      contentType: false,
      dataType: 'json'
    }).done(function(response) {
      if (response.error) {
        showError(response.error);
        return;
      }
      onSuccess(response);
    }).fail(function(xhr) {
      var message = 'Solvi request failed.';
      if (xhr.responseJSON && xhr.responseJSON.error) {
        message = xhr.responseJSON.error;
      }
      showError(message);
    }).always(function() {
      jQuery(buttonSelector).prop('disabled', false).text(doneText);
    });
  }

  jQuery('#sq-solvi-form').on('submit', function(e) {
    e.preventDefault();
    uploadSolvi('/ajax/seedquest/solvi/preview', '#sq-solvi-submit', 'Previewing...', 'Preview', function(response) {
      render(response);
    });
  });

  jQuery('#sq-solvi-verify').on('click', function() {
    uploadSolvi('/ajax/seedquest/solvi/verify', '#sq-solvi-verify', 'Verifying...', 'Verify Write', function(response) {
      render(response);
      var message = response.message || 'Breedbase write verification passed. No observations were stored.';
      if (response.warning) {
        message += ' Warning: ' + response.warning;
      }
      if (response.duplicates && response.duplicates.changed_value_count) {
        message += ' Changed values need review before import.';
      }
      showVerify(message, !!response.warning);
    });
  });
})();
</script>
